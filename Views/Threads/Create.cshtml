@model ForumDyskusyjne.Models.Thread

@{
    ViewData["Title"] = "Utwórz wątek";
    Layout = "_Layout";
}

<h1>Utwórz wątek</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="form-label">Tytuł</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label for="InitialMessage" class="form-label">Treść (pierwszy post)</label>
                <textarea id="InitialMessage" name="InitialMessage" class="form-control" rows="8" placeholder="Napisz treść pierwszego posta..." required></textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ForumId" class="form-label">Forum</label>
                <select asp-for="ForumId" class="form-select" asp-items="ViewBag.ForumId"></select>
                <span asp-validation-for="ForumId" class="text-danger"></span>
            </div>

            <!-- Jeśli chcesz, pozostaw pole AuthorId (dla adminów) -->
            <div class="form-group mb-3">
                <label asp-for="AuthorId" class="form-label">Autor (opcjonalnie)</label>
                <select asp-for="AuthorId" class="form-select" asp-items="ViewBag.AuthorId">
                    <option value="">(zalogowany użytkownik)</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Utwórz wątek</button>
            <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}